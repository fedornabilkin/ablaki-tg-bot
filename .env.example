# BotFather token. Never send it to the website or commit this file with real values.
TELEGRAM_BOT_TOKEN=
# Must match the username configured on the website (without @).
TELEGRAM_BOT_USERNAME=
# Public HTTPS API of the website. A path prefix is allowed.
ABL_API_BASE_URL=https://api.ablakin.ru
# Same secret as TELEGRAM_AUTH_API_KEY on the website backend (at least 32 characters).
TELEGRAM_AUTH_API_KEY=
# Displayed as plain text in every confirmation message.
ABL_SITE_URL=https://ablakin.ru
ABL_SITE_NAME=Аблакин
TELEGRAM_UPDATES_MODE=polling
NODE_ENV=production
BOT_DATA_DIR=/data
BOT_HEALTH_FILE=/tmp/bot-health.json
